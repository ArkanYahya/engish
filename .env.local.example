# Copy this file to .env.local (gitignored) and fill in the values from your Firebase
# project: console.firebase.google.com → Project settings → your web app → SDK setup and
# configuration → "Config".
#
# Vite only exposes env vars prefixed with VITE_ to client code — see src/lib/firebase.js.

VITE_FIREBASE_API_KEY=
# NOT the raw <project>.firebaseapp.com value Firebase gives you by default — use the app's
# own canonical domain instead (e.g. engish-seven.vercel.app), paired with the /__/auth/*
# proxy rewrite in vercel.json. This keeps Firebase's OAuth handler same-origin with the app,
# which sidesteps browsers blocking cross-origin storage during signInWithRedirect (see the
# Apple-sign-in-on-iPhone fix — Firebase's own docs call this out as a known production
# issue: https://firebase.google.com/docs/auth/web/redirect-best-practices). Requires: this
# exact domain added to Firebase's Authorized domains, and — for any provider that manages
# its own redirect URIs (Apple, not Google) — https://<this-domain>/__/auth/handler added on
# that provider's side too.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Also required for Vercel: add the same six variables (without the .env file) in the
# Vercel project's Settings → Environment Variables, so the deployed build has them too.
