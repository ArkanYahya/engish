# Copy this file to .env.local (gitignored) and fill in the values from your Firebase
# project: console.firebase.google.com → Project settings → your web app → SDK setup and
# configuration → "Config".
#
# Vite only exposes env vars prefixed with VITE_ to client code — see src/lib/firebase.js.

VITE_FIREBASE_API_KEY=
# Use the raw <project>.firebaseapp.com value Firebase gives you — do NOT point this at the
# app's own domain via a reverse proxy. That's Firebase's own documented mitigation for
# signInWithRedirect's cross-origin storage issue (see
# https://firebase.google.com/docs/auth/web/redirect-best-practices), and it looks
# appealing on paper, but tried in practice here (see git history around the
# Apple-sign-in-on-iPhone investigation) it broke BOTH Google and Apple sign-in — Firebase's
# auth-helper JS loads fine through a simple path-based proxy, but silently fails to complete
# its handoff to the provider when served from anything other than the exact domain Firebase's
# own console has on file. Left as a real limitation, not a TODO — revisit only with a much
# more complete proxy (matching Firebase Hosting's full reserved-URL set) if this becomes
# worth another attempt.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Also required for Vercel: add the same six variables (without the .env file) in the
# Vercel project's Settings → Environment Variables, so the deployed build has them too.
